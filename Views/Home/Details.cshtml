@model LuxuryHotel.Models.KhachSan

@{
    ViewData["Title"] = "Chi tiết - " + Model.TenKS;

    // Tự động gán tên hiển thị đại diện tương ứng theo từng mã khách sạn (khớp 100% với Rooms.cshtml)
    string tenPhongDisplay = itemTitle(Model.MaKS, Model.Phongs);

    string itemTitle(string maKS, IEnumerable<LuxuryHotel.Models.Phong>? phongs)
    {
        if (maKS == "KS01") return "Phòng Deluxe Hướng Biển";
        if (maKS == "KS02") return "Phòng Superior Double";
        if (maKS == "KS03") return "Phòng Executive Suite";
        if (maKS == "KS04") return "Phòng Premium King";
        if (maKS == "KS05") return "Phòng Family Suite";
        if (maKS == "KS06") return "Phòng Luxury Ocean View";
        if (maKS == "KS07") return "Phòng President Suite";
        if (maKS == "KS08") return "Phòng Standard Double";

        return (phongs != null && phongs.Any()) ? phongs.First().LoaiPhong : "Phòng Tiêu Chuẩn";
    }

    // Cấu hình danh sách 7 ảnh linh hoạt cho từng khách sạn (1 ảnh lớn + 6 ảnh nhỏ)
    List<string> images = new List<string>();

    if (Model.MaKS == "KS01") // Đà Nẵng (KS01)
    {
        images.Add("https://pix8.agoda.net/hotelImages/533079/0/9b655c1b0ada7a5e76651ab4e506dc21.png?ce=3&s=1024x");
        images.Add("https://q-xx.bstatic.com/xdata/images/hotel/max1024x768/891230135.jpg?k=f883fc032df37a18cc4d70314bf726548b25a5ced47e52d5ffcbaf18d8dc2805&o=&s=1024x");
        images.Add("https://pix8.agoda.net/hotelImages/533/533079/533079_16092916470047121712.jpg?ca=6&ce=1&s=1024x");
        images.Add("https://pix8.agoda.net/hotelImages/533079/0/314f128c34fdfe9c7a3d62be2cf2e081.jpg?ca=20&ce=0&s=1024x");
        images.Add("https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=400");
        images.Add("https://q-xx.bstatic.com/xdata/images/hotel/max1024x768/21757922.jpg?k=3350dd00b2d0cb5df9b2be7c0b715657703d58597deb0f1a55bd465fdeb0b85a&o=&s=1024x");
        images.Add("https://pix8.agoda.net/hotelImages/533079/0/0501aa05fadb7463c9c5b710fa9503a0.png?ce=3&s=1024x");
    }
    else if (Model.MaKS == "KS02") // Vũng Tàu (KS02)
    {
        images.Add("https://pix8.agoda.net/hotelImages/89090330/0/36acced664c5db2984ae2779a20570e3.jpg?ce=3&s=1024x");
        images.Add("https://pix8.agoda.net/hotelImages/89090330/1401753542/c5040c4e2b76c944fcfbcf71f61dca00.jpg?ce=3&s=1024x");
        images.Add("https://pix8.agoda.net/hotelImages/89090330/1401753545/74bead730ad4e45b1a1e94f25706a0e0.jpg?ce=3&s=1024x");
        images.Add("https://q-xx.bstatic.com/xdata/images/hotel/max1024x768/877870825.jpg?k=0871e1a5352725835da47ccd15804b62485754f61b7245518511e73ea1de7316&o=&s=1024x");
