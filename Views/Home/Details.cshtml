@model LuxuryHotel.Models.KhachSan

@{
    ViewData["Title"] = "Chi tiết - " + Model.TenKS;

    // Tự động gán tên hiển thị đại diện tương ứng theo từng mã khách sạn
    string tenPhongDisplay = itemTitle(Model.MaKS, Model.Phongs);

    string itemTitle(string maKS, IEnumerable<LuxuryHotel.Models.Phong>? phongs)
    {
        if (maKS == "KS01") return "Phòng Deluxe Hướng Biển";
        if (maKS == "KS02") return "Phòng Superior Double";
        if (maKS == "KS03") return "Phòng Executive Suite";
        if (maKS == "KS04") return "Phòng Premium King";
        if (maKS == "KS05") return "Phòng Family Suite";
        if (maKS == "KS06") return "Phòng Luxury Ocean View";
        if (maKS == "KS07") return "Phòng President Suite";
        if (maKS == "KS08") return "Phòng Standard Double";

        return (phongs != null && phongs.Any()) ? phongs.First().LoaiPhong : "Phòng Tiêu Chuẩn";
    }

    // Cấu hình danh sách 7 ảnh linh hoạt cho từng khách sạn
    List<string> images = new List<string>();

    if (Model.MaKS == "KS01") // Đà Nẵng (KS01)
    {
        images.Add("https://pix8.agoda.net/hotelImages/533079/0/9b655c1b0ada7a5e76651ab4e506dc21.png?ce=3&s=1024x");
        images.Add("https://q-xx.bstatic.com/xdata/images/hotel/max1024x768/891230135.jpg?k=f883fc032df37a18cc4d70314bf726548b25a5ced47e52d5ffcbaf18d8dc2805&o=&s=1024x");
        images.Add("https://pix8.agoda.net/hotelImages/533/533079/533079_16092916470047121712.jpg?ca=6&ce=1&s=1024x");
        images.Add("https://pix8.agoda.net/hotelImages/533079/0/314f128c34fdfe9c7a3d62be2cf2e081.jpg?ca=20&ce=0&s=1024x");
        images.Add("https://images.unsplash.com/photo-1631049307264-da0ec9d70304?w=400");
        images.Add("https://q-xx.bstatic.com/xdata/images/hotel/max1024x768/21757922.jpg?k=3350dd00b2d0cb5df9b2be7c0b715657703d58597deb0f1a55bd465fdeb0b85a&o=&s=1024x");
        images.Add("https://pix8.agoda.net/hotelImages/533079/0/0501aa05fadb7463c9c5b710fa9503a0.png?ce=3&s=1024x");
    }
    else if (Model.MaKS == "KS02") // Vũng Tàu (KS02)
    {
        images.Add("https://pix8.agoda.net/hotelImages/89090330/0/36acced664c5db2984ae2779a20570e3.jpg?ce=3&s=1024x");
        images.Add("https://pix8.agoda.net/hotelImages/89090330/1401753542/c5040c4e2b76c944fcfbcf71f61dca00.jpg?ce=3&s=1024x");
        images.Add("https://pix8.agoda.net/hotelImages/89090330/1401753545/74bead730ad4e45b1a1e94f25706a0e0.jpg?ce=3&s=1024x");
        images.Add("https://q-xx.bstatic.com/xdata/images/hotel/max1024x768/877870825.jpg?k=0871e1a5352725835da47ccd15804b62485754f61b7245518511e73ea1de7316&o=&s=1024x");
        images.Add("https://pix8.agoda.net/hotelImages/89090330/1401753546/a5592be951eb42d88e29297b2b7a9ef4.jpg?ce=3&s=1024x");
        images.Add("https://pix8.agoda.net/hotelImages/89090330/1401753546/995f00a1d948ea29f9b1711bbe653b60.jpg?ce=3&s=1024x");
        images.Add("https://pix8.agoda.net/hotelImages/89090330/0/9101ebb4ebda6b1114d0da0c55563ba3.jpg?ce=3&s=1024x");
    }
    else if (Model.MaKS == "KS03") // Nha Trang (KS03)
    {
        images.Add("https://pix8.agoda.net/hotelImages/1370938/9429410/bdf358280db48d5e196034e8a0abac4a.jpeg?ce=0&s=1024x");
        images.Add("https://q-xx.bstatic.com/xdata/images/hotel/max1024x768/152624637.jpg?k=49fbf084d2196ca99bf595cdc2f035a99d5ab3186dc8cc0fbd439f49afd18edd&o=&s=1024x");
        images.Add("https://pix8.agoda.net/property/77014050/0/8879040e01ee25d2fec6879952679671.jpeg?ce=2&s=1024x");
        images.Add("https://pix8.agoda.net/property/77014050/0/0515a331aeeeb0592a5e530bf01b6893.jpeg?ce=2&s=1024x");
        images.Add("https://q-xx.bstatic.com/xdata/images/hotel/max1024x768/152622883.jpg?k=ce14be1303483fd9461c77b19be1d76f4e4f73dc51f4f3e9c9f39b5ed8d9b268&o=&s=1024x");
        images.Add("https://pix8.agoda.net/property/1370938/0/a862c78c57a177366363df97cbbdb51f.jpeg?ce=3&s=1024x");
        images.Add("https://pix8.agoda.net/hotelImages/1370938/-1/abf7e9e830a08808e151439ce49cdd60.jpg?ca=8&ce=1&s=1024x");
    }
    else if (Model.MaKS == "KS04" || Model.MaKS == "KS08" || Model.DiaDiem.Contains("Hồ Chí Minh") || Model.DiaDiem.Contains("TP.HCM")) // TP.HCM
    {
        images.Add(Model.MaKS == "KS04" ? "https://pix8.agoda.net/hotelImages/62697262/0/5d00a964350ae460a1be0d0bf12148c3.jpg?ce=3&s=1024x" : "https://pix8.agoda.net/hotelImages/788687/-1/6750b024c8d90cbfdff5846f5c925933.jpg?ca=17&ce=1&s=1024x");
        images.Add("https://q-xx.bstatic.com/xdata/images/hotel/max1024x768/828802077.jpg?k=d12619b2cfd327aee55787cd8aef3ec35f5fc8a139c8af174860046ba7397886&o=&s=1024x");
        images.Add("https://pix8.agoda.net/hotelImages/62697262/0/6815ca6b1e7ba2aa7b583d2e1bcb56a5.jpg?ce=3&s=1024x");
        images.Add("https://q-xx.bstatic.com/xdata/images/hotel/max1024x768/623137526.jpg?k=41eb3d907092d303ec5a5e244fbd8b4458bda5120269d180bba82b80e35d32d1&o=&s=1024x");
        images.Add("https://q-xx.bstatic.com/xdata/images/hotel/max1024x768/828824337.jpg?k=3e88e2c92b057e9937a69c88cca127c4888572a2bfb14cfd6a18401be8470f39&o=&s=1024x");
        images.Add("https://pix8.agoda.net/hotelImages/62697262/0/1b5becd7e64e544b76b71b67135df179.jpg?ce=2&s=1024x");
        images.Add("https://q-xx.bstatic.com/xdata/images/hotel/max1024x768/590577821.jpg?k=1b9546d055333b76d2b1397b9af0d031dba21116af17950e463d800309d90a8f&o=&s=1024x");
    }
    else
    {
        for (int i = 0; i < 7; i++) images.Add("https://images.unsplash.com/photo-1566073771259-6a8506099945?w=600");
    }

    // Lọc danh sách phòng còn trống
    var phongsConTrong = Model.Phongs != null
        ? Model.Phongs.Where(p => string.Equals(p.TrangThaiPhong, "Trống", StringComparison.OrdinalIgnoreCase)).ToList()
        : new List<LuxuryHotel.Models.Phong>();
}

<div class="container my-4">
    <!-- 1. Lưới hình ảnh khách sạn -->
    <div class="row g-2 mb-4">
        <!-- 1 Ảnh lớn -->
        <div class="col-md-6">
            <img src="@images[0]"
                 class="img-fluid rounded-3 w-100 h-100 object-fit-cover"
                 style="min-height: 320px; max-height: 380px;"
                 alt="@tenPhongDisplay"
                 onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1566073771259-6a8506099945?w=800';">
        </div>
        <!-- 6 Ảnh nhỏ -->
        <div class="col-md-6">
            <div class="row g-2">
                @for (int i = 1; i <= 6; i++)
                {
                    <div class="col-4">
                        <img src="@images[i]"
                             class="img-fluid rounded-2 w-100 object-fit-cover"
                             style="height: 185px;"
                             alt="Góc ảnh phòng @i"
                             onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1618773928121-c32242e63f39?w=400';">
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Tên Khách Sạn / Phòng Display -->
    <h3 class="fw-bold mb-4">@tenPhongDisplay (@Model.TenKS)</h3>

    <!-- 2. Khung Điểm nổi bật nhất -->
    <div class="border border-dark rounded-3 p-3 mb-4 bg-white">
        <h6 class="fw-bold mb-2">Điểm nổi bật nhất</h6>
        <p class="mb-1 small">
            <i class="bi bi-geo-alt-fill text-primary"></i> <strong>Vị trí lý tưởng:</strong> @Model.DescriptionKS
        </p>
        <p class="mb-1 small"><strong>Spa nổi bật</strong></p>
        <p class="mb-0 small"><strong>Tầm nhìn đẹp</strong></p>
    </div>

    <!-- 3. Khung Cơ sở vật chất -->
    <div class="border border-dark rounded-3 p-3 mb-4 bg-white">
        <h6 class="fw-bold mb-3">Cơ sở vật chất</h6>
        <div class="row g-3 small fw-bold">
            <div class="col-md-3 col-6">Bãi biển riêng</div>
            <div class="col-md-3 col-6">Miễn phí Wi-Fi</div>
            <div class="col-md-3 col-6">Bể bơi</div>
            <div class="col-md-3 col-6">Đỗ xe miễn phí</div>
            <div class="col-md-3 col-6">Spa</div>
            <div class="col-md-3 col-6">Bàn tiếp tân [24 giờ]</div>
            <div class="col-md-3 col-6">Phòng tập</div>
            <div class="col-md-3 col-6">Nhà hàng</div>
        </div>
    </div>

    <!-- 4. Danh sách phòng của Khách sạn -->
    <h5 class="fw-bold mb-3">Danh sách phòng:</h5>

    @if (Model.Phongs != null && Model.Phongs.Any())
    {
        @foreach (var phong in Model.Phongs)
        {
            // 1. Tính tổng số đơn đã đặt của phòng này
            int soDonDaDat = phong.DonDatPhongs != null ? phong.DonDatPhongs.Count : 0;

            // Giả định tổng số lượng phòng sẵn có của loại này trong khách sạn là 3 phòng
            int tongSoPhong = 3;

            // 2. Tính số lượng phòng CÒN LẠI thực tế
            int soPhongConLai = tongSoPhong - soDonDaDat;
            if (soPhongConLai < 0) soPhongConLai = 0;

            bool isAvailable = soPhongConLai > 0;

            <div class="border border-dark rounded-3 mb-4 bg-white overflow-hidden">
                <div class="row g-0 align-items-center">
                    <!-- Chi tiết ảnh phòng -->
                    <div class="col-md-3">
                        <img src="https://images.unsplash.com/photo-1618773928121-c32242e63f39?w=500"
                             class="img-fluid w-100 h-100 object-fit-cover"
                             style="min-height: 190px;"
                             alt="@phong.LoaiPhong">
                    </div>

                    <!-- Thông tin & Trạng thái còn lại -->
                    <div class="col-md-4 p-3 border-end border-dark">
                        <h6 class="fw-bold mb-2">Tiêu chuẩn phòng: @phong.LoaiPhong</h6>

                        <!-- Hiển thị badge theo số lượng còn lại -->
                        <div class="mb-2">
                            @if (isAvailable)
                            {
                                <span class="badge bg-success px-3 py-1">
                                    <i class="bi bi-check-circle-fill me-1"></i> Còn trống (@soPhongConLai phòng)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger px-3 py-1">
                                    <i class="bi bi-x-circle-fill me-1"></i> Hết phòng
                                </span>
                            }
                        </div>

                        <p class="mb-1 extra-small text-muted"><i class="bi bi-person-fill"></i> @phong.SoNguoi Người lớn</p>
                        <ul class="list-unstyled extra-small mb-0 text-dark">
                            <li>• Có ăn sáng</li>
                            <li>• Quầy bar mini miễn phí</li>
                            <li>• Vào hồ bơi miễn phí</li>
                            <li>• Phòng tập</li>
                            <li>• Wifi miễn phí</li>
                        </ul>
                    </div>

                    <!-- Giá / Đêm -->
                    <div class="col-md-2 p-3 text-center border-end border-dark">
                        <span class="d-block fw-bold small mb-2">Giá / Đêm</span>
                        <small class="text-danger d-block extra-small fw-bold">Giá từ</small>
                        <span class="text-danger fw-bold fs-5">
                            @(Model.MaKS == "KS04" || Model.MaKS == "KS08" || Model.DiaDiem.Contains("Hồ Chí Minh") || Model.DiaDiem.Contains("TP.HCM")
                                ? "Liên hệ"
                                : phong.Gia.ToString("N0") + " VND")
                        </span>
                    </div>

                    <!-- Khung Chọn Số Lượng & Nút Đặt Phòng -->
                    <div class="col-md-3 p-3 text-center d-flex flex-column align-items-center justify-content-center gap-3">
                        @if (isAvailable)
                        {
                            <!-- Dynamic Dropdown: Chỉ render ra tối đa bằng với soPhongConLai -->
                            <div class="dropdown">
                                <select class="form-select rounded-pill text-center custom-select-box px-3 py-1" style="width: 170px;">
                                    <option value="1" selected>Số lượng phòng ⌵</option>
                                    @for (int i = 1; i <= soPhongConLai; i++)
                                    {
                                        <option value="@i">@i Phòng</option>
                                    }
                                </select>
                            </div>

                            <a asp-controller="Booking"
                               asp-action="Create"
                               asp-route-maKS="@Model.MaKS"
                               asp-route-maPhong="@phong.MaPhong"
                               class="btn btn-secondary rounded-pill px-4 py-2 custom-btn-booking d-flex align-items-center justify-content-center"
                               style="width: 170px; background-color: #d1d5db; color: #000; border: none; text-decoration: none;">
                                Đặt phòng
                            </a>
                        }
                        else
                        {
                            <!-- Khi đã hết sạch cả 3 phòng -->
                            <button class="btn btn-secondary rounded-pill px-4 py-2 d-flex align-items-center justify-content-center disabled"
                                    style="width: 170px; background-color: #9ca3af; color: #fff; border: none; cursor: not-allowed;" disabled>
                                Hết phòng
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning text-center">Khách sạn này hiện chưa có thông tin phòng.</div>
    }
</div>

<style>
    .extra-small {
        font-size: 0.85rem;
    }

    .custom-select-box {
        border: 1px solid #000;
        font-size: 0.9rem;
        background-color: #fff;
    }

    .custom-btn-booking {
        font-weight: 500;
        transition: background-color 0.2s ease;
    }

        .custom-btn-booking:hover {
            background-color: #9ca3af !important;
            color: #fff;
        }
</style>