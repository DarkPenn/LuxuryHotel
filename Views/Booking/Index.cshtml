
@{
    ViewData["Title"] = "Đặt phòng";
}

<link rel="stylesheet" href="~/css/booking.css">

<div class="booking-page">

    <div class="container">

        <div class="row">

            <div class="col-lg-8">

                <div class="booking-form">

                    <h2>
                        Thông tin đặt phòng
                    </h2>

                    <div class="row">

                        <div class="col-md-6">

                            <div class="form-group">

                                <label>
                                    Họ *
                                </label>

                                <input type="text" class="form-control" placeholder="Nhập họ">

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="form-group">

                                <label>
                                    Tên *
                                </label>

                                <input type="text" class="form-control" placeholder="Nhập tên">

                            </div>

                        </div>

                    </div>

                    <div class="form-group">

                        <label>
                            Email *
                        </label>

                        <input type="email" class="form-control" placeholder="example@gmail.com">

                    </div>

                    <div class="row">

                        <div class="col-md-6">

                            <div class="form-group">

                                <label>
                                    Quốc gia
                                </label>

                                <select class="form-select">

                                    <option>
                                        Việt Nam
                                    </option>

                                    <option>
                                        Nhật Bản
                                    </option>

                                    <option>
                                        Hàn Quốc
                                    </option>

                                    <option>
                                        Singapore
                                    </option>

                                </select>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="form-group">

                                <label>
                                    Số điện thoại
                                </label>

                                <input type="text" class="form-control" placeholder="09xxxxxxxx">

                            </div>

                        </div>

                    </div>

                    <div class="form-group">

                        <label>
                            Ghi chú
                        </label>

                        <textarea class="form-control" rows="6" placeholder="Nhập yêu cầu đặc biệt..."></textarea>

                    </div>

                </div>

            </div>

            <div class="col-lg-4">

                <div class="booking-summary">

                    <h3>
                        Quyền lợi miễn phí
                    </h3>

                    <ul>

                        <li>
                            WiFi tốc độ cao
                        </li>

                        <li>
                            Buffet sáng
                        </li>

                        <li>
                            Hồ bơi ngoài trời
                        </li>

                        <li>
                            Phòng Gym
                        </li>

                        <li>
                            Bãi đỗ xe miễn phí
                        </li>

                        <li>
                            Hủy miễn phí trước 24 giờ
                        </li>

                    </ul>

                    <hr>

                    <div class="price-box">

                        <span>
                            Tổng tiền
                        </span>

                        <h2>
                            2.500.000đ
                        </h2>

                    </div>

                    <button class="btn-book">

                        Đặt phòng

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>

