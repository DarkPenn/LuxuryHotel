@model IEnumerable<LuxuryHotel.Models.ViewModels.HotelCardVM>

@if (!Model.Any())
{
    <div class="text-center mt-5">
        <h3>Không tìm thấy khách sạn phù hợp.</h3>
    </div>
}
else
{
    @foreach (var item in Model)
    {
        <div class="hotel-item">

            <a asp-controller="Hotel"
               asp-action="Detail">
                <img src="@item.Image" alt="@item.Name" />
            </a>

            <div class="hotel-info">

                <h3>
                    <a asp-controller="Hotel"
                       asp-action="Detail">
                        @item.Name
                    </a>
                </h3>

                <div class="stars">
                    @for (int i = 0; i < item.Star; i++)
                    {
                        <span>★</span>
                    }
                </div>

                <div class="address">
                    📍 @item.Address
                </div>

                <p>
                    @item.Description
                </p>

            </div>

            <div class="hotel-right">

                <div class="score">
                    @item.Score
                </div>

                <div class="review">
                    @item.Review
                </div>

                <small>
                    Giá mỗi đêm
                    @(item.IncludeTax ? "(đã bao gồm thuế)" : "(chưa bao gồm thuế)")
                </small>

                <div class="price">
                    @item.Price
                </div>

                <a asp-controller="Hotel"
                   asp-action="Detail"
                   class="btn-book">
                    Xem chi tiết
                </a>

            </div>

        </div>
    }
}