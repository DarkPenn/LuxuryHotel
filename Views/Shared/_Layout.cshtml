@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - LX Hotel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="container-fluid px-0">
            <div class="d-flex justify-content-between align-items-center custom-header px-4">
                <!-- Logo LX Hotel -->
                <div class="d-flex align-items-center">
                    <a class="navbar-brand text-white fw-bold fs-4 me-4 d-flex align-items-center" asp-controller="Home" asp-action="Index">
                        <img src="~/Images/logoTH.png" alt="LX Hotel Logo">
                    </a>
    
                    <!-- Nút 1 & 2: Khách Sạn, Phòng -->
                    <div class="d-flex gap-2">
                        <a asp-controller="Hotel" asp-action="Index" class="btn btn-light custom-nav-btn text-dark">Khách Sạn</a>
                        <a asp-controller="Home" asp-action="Rooms" class="btn btn-light custom-nav-btn text-dark">Phòng</a>
                    </div>
                </div>

                @if (Context.Session.GetString("CustomerId") == null)
                {
                <!-- Nút 3: Đăng ký & Đăng nhập -->
                <div class="d-flex gap-2">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-light custom-nav-btn text-dark">Đăng ký</a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-light custom-nav-btn text-dark">Đăng nhập</a>
                </div>
                }
                else
                {
                    <div class="d-flex align-items-center">
                        <button class="d-flex gap-2">
                            👤
                            <strong>
                                @Context.Session.GetString("CustomerName")
                            </strong>
                        </button>    
                        <div class="dropdown-content">
                            <a asp-controller="Account"
                               asp-action="Logout" class="navbar-brand text-white fw-bold fs-4 me-4 d-flex align-items-center">
                                <img src="~/Images/logout.png" alt="LogOut Button">
                            </a>
                        </div>
                    </div>
                    
                }
            </div>
        </div>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Thư viện SweetAlert2 hiển thị Popup -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Tự động bật Popup nếu Đặt phòng thành công -->
    @if (TempData["SuccessMessage"] != null)
    {
        <script>
                Swal.fire({
                    title: 'Đặt phòng thành công!',
                    text: '@Html.Raw(TempData["SuccessMessage"])',
                    icon: 'success',
                    confirmButtonText: 'Đồng ý',
                    confirmButtonColor: '#005c9e'
                });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)</body>
</html>