@{
    ViewData["Title"] = "Danh sách khách sạn";
}

<link rel="stylesheet" href="~/css/hotel.css">

<div class="container mt-4">

    <h3 class="text-center mb-4">
		Danh sách khách sạn
    </h3>

    <div class="hotel-layout">

        <!-- Sidebar -->

        <aside class="filter">

            <h4>Đánh giá sao</h4>

            <label><input type="checkbox"> 5 sao</label>

            <label><input type="checkbox"> 4 sao</label>

            <label><input type="checkbox"> 3 sao</label>

            <label><input type="checkbox"> 2 sao</label>

            <label><input type="checkbox"> 1 sao</label>

            <hr>

            <h4>Điểm đánh giá</h4>

            <label><input type="checkbox"> Trên 9+</label>

            <label><input type="checkbox"> Rất tốt 8+</label>

            <label><input type="checkbox"> Tốt 7+</label>

            <label><input type="checkbox"> Dễ chịu 6+</label>

        </aside>

        <!-- Hotel List -->

        <section class="hotel-list">

            @await Component.InvokeAsync("HotelList")

        </section>

    </div>

</div>