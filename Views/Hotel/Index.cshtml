<div class="hotel-card">
    <img src="~/images/hotel1.jpg" alt="Hotel">

    <div class="hotel-info">
        <h2>The Sóng Vũng Tàu</h2>

        <p class="location">
            <i class="fa-solid fa-location-dot"></i>
            28 Thi Sách, Vũng Tàu
        </p>

        <div class="rating">
            ★★★★★
            <span>(2.350 đánh giá)</span>
        </div>

        <p class="description">
            Khách sạn 5 sao với hồ bơi vô cực, spa, phòng gym và view biển.
        </p>
    </div>

    <div class="price-box">
        <span class="price">1.250.000đ</span>

        <span>/ đêm</span>

        <a asp-controller="Hotel" asp-action="RoomDetail" class="btn-detail">
            Xem chi tiết
        </a>
    </div>
</div>